# Copy these names into your shell, IDE run configuration, or an untracked .env file.
# Never commit real values.

# Infrastructure. Required by the dev, test and prod profiles, which carry no
# hardcoded hosts or credentials. Local development normally runs
# `--spring.profiles.active=dev,local`, where application-local.yml supplies the
# datasource and redis settings instead, so only NACOS_SERVER_ADDR applies there
# (and it already defaults to 127.0.0.1:8848).
DB_HOST=
DB_PORT=3306
DB_NAME=tg_trip_spa
DB_USERNAME=
DB_PASSWORD=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
NACOS_SERVER_ADDR=127.0.0.1:8848
# Only the test profile reads these; leave blank when Nacos needs no auth.
NACOS_NAMESPACE=dev
NACOS_USERNAME=
NACOS_PASSWORD=

EXPEDIA_API_KEY=
EXPEDIA_SHARED_SECRET=
EXPEDIA_CUSTOMER_IP=127.0.0.1
EXPEDIA_CUSTOMER_SESSION_ID=trip-booking-spa-local
EXPEDIA_API_HOST=https://test.ean.com

# Optional: point legacy supplier beans at a local mock server.
MOCK_SUPPLIER_BASE_URL=https://mock.invalid

# Optional: override the local profile's docker container settings. Each key
# defaults to what application-local.yml ships, so leaving these unset works
# out of the box; set them only when your containers differ.
LOCAL_DB_HOST=
LOCAL_DB_PORT=
LOCAL_DB_NAME=
LOCAL_DB_USERNAME=
LOCAL_DB_PASSWORD=
LOCAL_REDIS_HOST=
LOCAL_REDIS_PORT=
LOCAL_REDIS_PASSWORD=

# Elong (艺龙). Test and production gateways share the same credentials;
# ELONG_API_HOST defaults to the test gateway (https://api-test.elong.com/rest).
ELONG_USER=
ELONG_APP_KEY=
ELONG_SECRET=
ELONG_API_HOST=
# Booking CustomerIPAddress fallback (Elong risk control requires an IP).
# Defaults to the egress IP proven in cursor production; not a secret.
ELONG_CUSTOMER_IP_FALLBACK=
