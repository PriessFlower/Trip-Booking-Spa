# Nacos Data ID: trip-booking-spa.yaml
# Group: DEFAULT_GROUP
# Keep structured runtime values as JSON strings so they remain compatible with
# the values previously stored in Apollo.

query:
  cache:
    supplier: '[10005]'

supplier:
  hotel:
    cache:
      map: '{"10005":["16024166"]}'
  query:
    timezone: '["10005"]'

expedia:
  query:
    price:
      cache:
        qps: 10
      queue:
        task:
          switch: 1
          return: 1

# 定时任务开关与调度（enabled 为运行时动态读取，改配置即生效；cron 仅启动时读取，改后需重启）
task:
  expedia-hotel-sync:
    enabled: false
    cron: '0 0 2 * * ?'
    update-days: 1
  expedia-remove-hotel:
    enabled: false
    cron: '0 0 4 * * ?'
    delete-date: ''
  expedia-cps:
    enabled: false
    cron: '0 0/30 * * * ?'
  ratehawk-cps:
    enabled: false
    cron: '0 15/30 * * * ?'
