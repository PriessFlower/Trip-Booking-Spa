# Nacos Data ID: trip-booking-spa.yaml
# Group: DEFAULT_GROUP
#
# 键名规则见 PROJECT.md §3.7：<域>.<对象>.<属性>，域为封闭枚举 task / ratelimit / cache / supplier。
# 集合类取值以 JSON 字符串表示（沿用 Apollo 时期格式）。
# 代码中的兜底默认值一律为安全侧取值，与本文件取值不同；部署前须确认目标环境已包含本文件全部键。

# ── task：定时任务及其运行行为 ──────────────────────────────
# enabled 运行时动态读取，改配置即生效；cron 仅启动时读取，改后需重启。
task:
  # Expedia 刷价：把价格刷进我方 Redis 缓存。一次调度消费一轮任务表，刷完即结束。
  expedia-cps:
    enabled: false            # 唯一闸口：是否按 cron 自动刷价
    cron: '0 0/30 * * * ?'    # 每 30 分钟
    batch-size: 1000          # 单轮取任务上限。清单总行数 / 本值 = 刷完一遍所需轮数

  # 艺龙刷价：结构同上。额度与 tg-trip-cursor 的艺龙刷价【共用同一个 10 QPS 账号配额】，
  # 故 enabled=true 的前置是【cursor 侧已停刷艺龙】——2026-08-17 生产实测，
  # 速率 0.62 QPS 时查价成功率仅 73%，降到约 0.4 QPS 后 92%，掉的全是 A201010001（访问太频繁）。
  #
  # qps=1.0 × batch-size=500 × 每 10 分钟一轮 ≈ 每天 7.2 万条，
  # 对艺龙库 23,584 家即每天全量覆盖三轮（cursor 现状为 24h 刷 45,235 条 / 16,998 家）。
  # 调整前先看刷价日志的"失败="计数：那是频控命中的直接指标。
  elong-cps:
    # 每行任务按这些成人数各查一次（逗号分隔）。高德按 2 人问价，缺 2 人片=曝光断粮（2026-08-22 事故）
    occupancies: "1,2"
    # 成交档：高德出过单的酒店（priority=2 的行，T+0~2）。批量须 ≥ 档内行数，保证一轮扫完
    deal-batch-size: 1500
    deal-concurrency: 6
    # 远期档：成交酒店 T+7~29（priority=3 的行），小批滚动，约一天扫完一遍
    far-batch-size: 200
    far-concurrency: 6
    enabled: false
    cron: '0 0/10 * * * ?'    # 每 10 分钟一轮（cron 仅启动时读取，改后需重启）
    # 批次3 两档优先级（F-2.4）：每轮先高频档(priority=0,T+0~T+2,带借入验价升档行)
    # 再常规档(priority=1,T+3~T+6)。默认 400@2qps + 200@1qps ≈ 6.7 分钟 < cron 周期，
    # 高频档 ~2.6h 轮一遍。旧键 qps/batch-size 自批次3起弃用（避免继承单档时代旧值）。
    high-batch-size: 400
    normal-batch-size: 200
    # 刷价速率不在本域——它是统一限流的子配额，见下方 ratelimit.qps 的
    # GLOBAL_LIMIT:ELONG:SPA_SUPPLIER_API_PRODUCT_PRICES:REFRESH（§3.3：限流一律走统一限流）。
    # 曾在此处配 high-qps/normal-qps 并在代码里自建 Guava RateLimiter，是对该条的违反：
    # 同一件事有了两个开关、两处取值，运维改了统一限流却不生效。2026-08-19 已收口。
    # 行级并发度。2026-08-19 实测：串行时单行均值 1.45s（p50 1.08 / p90 3.13 / p99 4.51），
    # 于是限额设 2 QPS 也只跑出 0.89——限流器从来不是瓶颈，串行才是。并发度 ≈ 目标 QPS × 单行耗时：
    #   高频档 4 QPS × 1.45s ≈ 6，常规档 1 QPS × 1.45s ≈ 2（给 3 留富余）
    # 上调前先看两处：① Redis 连接池（出价链路读同一个池，抢连接会拖慢真实客流）；
    # ② 线程若堆在 acquire() 上超过 ratelimit.acquire-timeout-ms 会变成假失败。
    high-concurrency: 6
    normal-concurrency: 3

  # Expedia 静态酒店同步
  expedia-hotel-sync:
    enabled: false
    cron: '0 0 2 * * ?'       # 每日 02:00
    update-days: 1            # 增量天数

  # Expedia 下线酒店清理
  expedia-remove-hotel:
    enabled: false
    cron: '0 0 4 * * ?'       # 每日 04:00
    delete-date: ''           # 指定日期；空=默认取 7 天前

# ── ratelimit：调用外部接口的限流 ───────────────────────────
# key = GLOBAL_LIMIT:供应商:接口（BaseHttpAccess.buildGlobalLimitKey 产出）。
# 未在 qps 表中列出的 key 使用 default-qps。改 qps 热生效（@RefreshScope）。
ratelimit:
  default-qps: 20
  acquire-timeout-ms: 5000
  # 下单与查单的配额刻意远低于查价：正常业务量下单远少于查价，给高值只会在异常时
  # 放大重复提交；而本层为快速失败，下单被自身限流挡掉会直接影响成单，故取值需宽于
  # 真实峰值——5 QPS 约合每小时 1.8 万单，远高于可预见业务量，正常运行不会触发。
  # 艺龙全账号硬额度 10 QPS（供应商契约，且与 tg-trip-cursor 生产刷价共享），
  # 各接口配额之和不得超过它：查价 5 / 验价 2 / 下单 1 / 查单 1 / 取消 1 = 10。
  # 验价链路每次先重打一次查价（现取现验），查价须留大头；订单三链路流量极低，
  # 各留 1 QPS 已远高于可预见业务量（1 QPS=每小时 3600 次）。
  #
  # 键分两级（BaseHttpAccess 按 CallPurpose 拼）：
  #   GLOBAL_LIMIT:<供应商>:<接口>          接口桶 = 对供应商的承诺，不得超过其接口能力
  #   GLOBAL_LIMIT:<供应商>:<接口>:<用途>   用途桶 = 我方内部怎么分，之和不得超过接口桶
  # hotel.detail 有三路消费方，各占一个用途桶：REFRESH 后台刷价（阻塞排队）、
  # CHECK_PRICE 点订前的现取现验、LIVE 上游绕过缓存的实时查价（后两路客人在等，快速失败）。
  # 用途桶未登记时只扣接口桶——那等于"刷价可以吃满整个承诺、客流一格不留"，故三路都要登记。
  # 艺龙的接口能力见 config/supplier-capability/elong.yaml（按方法各自限，无账号总额）。
  qps: '{"GLOBAL_LIMIT:EXPEDIA:STATIC_CONTENT":15,"GLOBAL_LIMIT:EXPEDIA:STATIC_REGIONS":10,"GLOBAL_LIMIT:EXPEDIA:SPA_SUPPLIER_API_PRODUCT_PRICES":50,"GLOBAL_LIMIT:EXPEDIA:SPA_SUPPLIER_API_PRODUCT_PRICES:REFRESH":10,"GLOBAL_LIMIT:EXPEDIA:SPA_SUPPLIER_API_PRODUCT_PRICES:LIVE":10,"GLOBAL_LIMIT:EXPEDIA:SPA_SUPPLIER_API_ORDER_PRICE":50,"GLOBAL_LIMIT:EXPEDIA:SPA_SUPPLIER_API_CREATE_ORDER":5,"GLOBAL_LIMIT:EXPEDIA:SPA_SUPPLIER_API_QUERY_ORDER":10,"GLOBAL_LIMIT:ELONG:SPA_SUPPLIER_API_PRODUCT_PRICES":6,"GLOBAL_LIMIT:ELONG:SPA_SUPPLIER_API_PRODUCT_PRICES:REFRESH":4,"GLOBAL_LIMIT:ELONG:SPA_SUPPLIER_API_PRODUCT_PRICES:CHECK_PRICE":1,"GLOBAL_LIMIT:ELONG:SPA_SUPPLIER_API_PRODUCT_PRICES:LIVE":1,"GLOBAL_LIMIT:ELONG:SPA_SUPPLIER_API_ORDER_PRICE":2,"GLOBAL_LIMIT:ELONG:SPA_SUPPLIER_API_CREATE_ORDER":1,"GLOBAL_LIMIT:ELONG:SPA_SUPPLIER_API_QUERY_ORDER":1,"GLOBAL_LIMIT:ELONG:SPA_SUPPLIER_API_CANCEL_ORDER":1}'

# ── supplier / expedia：静态数据摄取总开关 ──────────────────
# ── cache：我方自建缓存 ────────────────────────────────────
cache:
  price:
    suppliers: '[10005]'                      # 查价走我方缓存的供应商
    hotels: '{"10005":["16024166"]}'          # 走缓存的酒店白名单；某供应商对应空列表=其全部酒店走缓存

    # TTL 分档（docs/price-refresh.md F-4）：按入住日期远近给不同存活期。
    # TTL 不只是省内存——它是刷价失败时的兜底降级：刷不动则缓存自然过期、上游查不到、
    # 如实回报无价，而不是拿越来越陈的价对外报（R-1.6）。
    #
    # ttl-zone 判定"今天/未来/过期"，【必须显式指定，不得用服务器时区】：
    # 生产容器跑在 UTC 而业务日界是北京时间，用服务器时区会让同一份价在不同环境下
    # 得到不同存活期。issue #62（退改截止时间随服务器时区漂移 8 小时）是同类错误的先例。
    ttl-zone: Asia/Shanghai
    ttl-future-hours: 24        # 未来日期：须 ≥ 一个刷价周期，否则刷回来之前就先没了
    ttl-past-hours: 6           # 已过期日期：仅供对账追溯
    ttl-today-until-hour: 1     # 今天的价延到次日几点，留跨零点的收尾流量窗口

    # 入缓存裁剪（docs/price-refresh.md F-3）：按 productKey 等价类分组，每组只留最低价前 N 条。
    # 供应商通用。全量存储不可行——艺龙实测单酒店单日期 102~115 条，按 2,056 家有货酒店 ×
    # 30 天窗口计约 9.9 GB Redis。
    #
    # 分组键取 productKey 而非"含早"（cursor 的做法）：后者粒度更粗，会把同房型同含早但
    # 退改不同的产品挤进一组，"贵些但可免费取消"那条被裁掉、该卖法在比价中整体消失。
    # 实测效果：115 条 → 41 个等价类 → 保留 65 条（降 42%），且每个卖法都留有代表。
    #
    # 每个等价类只留最低价那 1 条。取值 ≤0 = 关闭裁剪（仅排障用，常态下违反 F-3.1）。
    #
    # 早先取 2 的理由是「为 resolve 换票留备份票（一个 key 对应多张在售票是常态，R-1.4）」，
    # 2026-08-19 已在生产改为 1，两条原因：
    #   ① 价格缓存的 field 就是 productKey——同一等价类的多条会写进【同一个 field】，
    #      后写覆盖先写；而裁剪按价升序保留，留 2 条的净效果是让第二便宜的覆盖最便宜的；
    #   ② 「留备份票」没有消费方：resolve 依 R-3.1 只许打供应商实时现货，
    #      明令禁止从我方缓存取候选。
    keep-per-product-key: 1

    # 异常价拦截（docs/price-refresh.md F-7，issue #70）：新价相对缓存中的上一轮价
    # 暴跌时拒绝写入、保留旧价并落 warn 日志。供应商通用——接一家新供应商即自动受保护。
    #
    # 防的是"供应商数据出错 → 错价刷进缓存 → 客人看到 → 按错价成交"这条无人质疑的链路。
    # 三系统对比：hotel-spa 有此防线；cursor 只做变价记录不拦截（其 SnapshotDiff 被丢弃）。
    #
    # 两个阈值取自艺龙生产在售价 64,918 条实测分布（均值 897 元）：
    #   drop-ratio 0.5  腰斩才拦。艺龙促销常见 20~30% 折扣，定低会大量误拦真促销。
    #                   宽松起步，据 warn 日志的拦截量再收紧。取值域 [0,1]。
    #   floor-cents 10000  旧价低于 100 元不拦（低价房波动大、绝对损失有限）。
    #                   覆盖 98.5% 的在售价；刻意不取 hotel-spa 的 200 元——那会把
    #                   100~200 元这段漏在保护外（艺龙 100~300 元段占 29.7%）。
    abnormal-drop-ratio: 0.5
    abnormal-floor-cents: 10000

  # 报价句柄（offerId → 供应商下单凭据）的存活秒数。
  #
  # ⚠️ 本值必须短于供应商下单凭据自身的有效期，否则会取回一个已失效的凭据去下单。
  # Expedia 的下单令牌约 10 分钟，故取 600。
  #
  # 调大的代价：句柄比凭据活得久，下单时才发现凭据已失效，而此刻旅客已经付了钱。
  # 调小的代价：上游多验一次价，仅此而已。故拿不准时应当往小调。
  offer:
    ttl-seconds: 600

  # ── cache.product-attribute：出价读侧的产品属性进程内缓存 ──
  #
  # 属性（房型 id、产品名、餐食规范串、退改类）按 productKey 取自档案表
  # supplier_product_base，不再随每轮刷价重写进 Redis（R-2.6 按腐性分层）。
  #
  # 只设容量不设 TTL：这个映射跨刷价周期稳定——房型/餐食/退改类一旦变化，
  # productKey 本身就变了，那是另一条记录，不存在"同一条的属性变了"。
  # 满时按插入顺序淘汰十分之一；冷键下次查回即可，代价只是一次批量查库。
  # 按实测每条约 300 字节估，5 万条约 15MB。
  product-attribute:
    max-size: 50000

# ── supplier：与特定供应商交互的行为 ────────────────────────
supplier:
  expedia:
    # 当天入住拦截闸口：名单内的酒店（泰韩部分店）当天入住不报价。
    # on  = 拦截（现行）；off = 放行，这些店当天入住照常报价。
    # 误开风险=报出的价大概率验价失败；误关风险=当天入住查无报价。
    # 名单本身在制品里（11,681 条 126KB，超 Nacos 单配置上限；本质是酒店层事实，
    # 归宿应是 supplier_hotel_base 的一列）。本开关只解决「不发版能否关掉」（§3.8.6）。
    same-day-block-enabled: true

    # 静态数据摄取总开关。关闭时目录清单与内容摄取接口一律拒绝调用
    # （播种、ExpediaHotelSyncTask 每日增量同步均失效）。改后需重启容器方生效。
    # 注意：expedia.booking-enabled 与 expedia.production-endpoint-enabled 为安全护栏，
    # 固定在 application.yml，禁止移入本文件（PROJECT.md §3.2.3）。
    static-data-enabled: true

    # resolve 管线开关（docs/product-identity.md §3）：验价时所点报价已不在，
    # 允许按上游携带的 productKey 在当前现货中自动换等价新票。
    # 关闭时行为与旧实现完全一致（直接回报 RATE_DEAD）。改后需重启容器方生效。
    resolve-enabled: false

    # resolve 换票价格容差（R-3.3 双门取严）：新价 ≤ 展示价 + min(展示价×比例, 绝对帽)。
    # 比例门吃的是毛利（实测成交毛利 7~11%，2% 任意单价不亏损）；绝对帽是单笔自动
    # 让利的财务上限（比例制敞口随单价放大：5 万单 2%=1000 元；实测存在 3% 薄单与
    # 负毛利单，取证 issue #59）。比例取值域 [0, 0.2]，帽取值域 [0, 100000] 分。
    resolve-price-tolerance: 0.02
    resolve-price-cap-cents: 2000            # 20 元：1000 元以下主流单仍由比例门管

    # 下单时提交给 Expedia 的固定联系与账单信息，均为我方（affiliate）信息而非旅客信息。
    #
    # ⚠️ booking-email 改动前须知：反查订单必须使用与下单时完全一致的邮箱
    # （GET /v3/itineraries?affiliate_reference_id=..&email=..）。改此值后，
    # 改动之前创建的订单将无法再用新邮箱反查——而反查是下单结果不确定时的唯一确证手段。
    # 故此值应长期稳定；确需更换时，须保留旧值以便反查历史订单。
    #
    # 该邮箱同时接收 Expedia 的订单确认与取消通知，应指向运营团队可长期查收的信箱。
    booking-contact: '{"email":"2837198145@qq.com","phoneCountryCode":"86","phoneNumber":"2837198145","givenName":"NEO","familyName":"NEO","addressLine1":"Kejiyuan Road 1","city":"Shenzhen","stateProvinceCode":"GD","postalCode":"518000","countryCode":"CN"}'

  elong:
    # resolve 管线开关（docs/product-identity.md §3）：验价时所点报价码（GoodsUniqId，
    # 会话级易腐）已不在现货，允许按上游携带的 productKey 在本会话现货中自动换等价新票。
    # 关闭时行为与不带 productKey 一致（直接回报 RATE_DEAD）。改后需重启容器方生效。
    resolve-enabled: false
    # 产品建档(R-2.6):稳定事实(房型/餐食/退改/productKey)落目录表,Redis 只留价与易腐码。
    # 默认关——开启会给每轮刷价增加数千次 upsert,须先观察写入耗时对刷价周期的影响。
    catalog-enabled: false

    # resolve 换票价格容差（R-3.3 双门取严，语义同 supplier.expedia 同名两键）
    resolve-price-tolerance: 0.02
    resolve-price-cap-cents: 2000
