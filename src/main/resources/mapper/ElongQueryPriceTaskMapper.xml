<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.trip.booking.spa.gateway.adapter.outbound.state.catalog.ElongQueryPriceTaskMapper">

    <resultMap id="BaseResultMap" type="com.trip.booking.spa.gateway.adapter.outbound.supplier.elong.shared.ElongQueryPriceTask">
        <result column="id" property="id" jdbcType="BIGINT" />
        <result column="sh_id" property="shId" jdbcType="VARCHAR" />
        <result column="delay_check_in" property="delayCheckIn" jdbcType="INTEGER" />
        <result column="delay_check_out" property="delayCheckOut" jdbcType="INTEGER" />
        <result column="query_count" property="queryCount" jdbcType="INTEGER" />
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP" />
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP" />
        <result column="last_time" property="lastTime" jdbcType="TIMESTAMP" />
        <result column="priority_level_number" property="priorityLevelNumber" jdbcType="INTEGER" />
        <result column="temporary_upgrade" property="temporaryUpgrade" jdbcType="INTEGER" />
        <result column="upgrade_deadline" property="upgradeDeadline" jdbcType="TIMESTAMP" />
    </resultMap>

    <sql id="BASE_LIST">
        id, sh_id, delay_check_in, delay_check_out, query_count, update_time, last_time, priority_level_number, temporary_upgrade, upgrade_deadline
    </sql>

    <!--
      两档的取批条件必须互斥且穷尽:任一行在任一时刻恰好命中一档。否则会出现两档都
      不匹配的孤儿行,而"升档复位"只在 Java 侧、且只在行被取到时执行
      (ElongCPSQueryPriceServiceImpl)——取不到即永不复位,永不再刷(issue #95)。

      有效档的定义(借入即"档 0 临时接管"):
        借入中 = temporary_upgrade = 1 且 (upgrade_deadline 为空 或 尚未到期)
        有效档 0 = priority_level_number = 0 或 借入中
        有效档 1 = priority_level_number = 1 且 非借入中

      故常规档必须显式接纳"升档已过期"的行:它们已不在借入中,回本档由本档取走,
      Java 顺势复位。改动此处务必保持两条件互为取反。
    -->
    <select id="getQueryPriceTaskList" resultMap="BaseResultMap">
        SELECT
        <include refid="BASE_LIST"/>
        FROM elong_query_price_task
        WHERE priority_level_number = #{priorityLevelNumber}
        <if test="1 == temporaryUpgrade">
            or (temporary_upgrade = 1 and (upgrade_deadline is null or upgrade_deadline &gt; now()))
        </if>
        <if test="0 == temporaryUpgrade">
            and (temporary_upgrade = 0 or (upgrade_deadline is not null and upgrade_deadline &lt;= now()))
        </if>
        order by update_time limit #{batchSize}
    </select>

    <update id="updateAddCount"
            parameterType="com.trip.booking.spa.gateway.adapter.outbound.supplier.elong.shared.ElongQueryPriceTask">
        update elong_query_price_task
        set query_count = #{queryCount} + 1 , last_time = #{updateTime}, temporary_upgrade = #{temporaryUpgrade}
        WHERE id = #{id}
    </update>

    <!-- 批次4 反馈环:验价事件把该酒店全部日期行临时升档 24h,高频档借入跟刷 -->
    <update id="upgradeByShId">
        update elong_query_price_task
        set temporary_upgrade = 1, upgrade_deadline = timestampadd(hour, 24, now())
        WHERE sh_id = #{shId}
    </update>

</mapper>
