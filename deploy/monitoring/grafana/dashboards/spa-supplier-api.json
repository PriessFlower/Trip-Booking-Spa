{
  "uid": "spa-supplier-api",
  "title": "供应商",
  "description": "按供应商看的一切：我们打出去的每一次调用（量/成功率/延时/错误码）、刷价、验价。数据源＝通道层唯一闸门 BaseHttpAccess 与刷价/验价模板，supplier 是标签不是筛选器——各家同图并排，坏的那家一眼看出来。",
  "tags": [
    "spa",
    "supplier"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "调用（supplier_io_* · 我们打出去的每一次）",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "调用量（按终态，次/秒）",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "spa-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "spa-prom"
          },
          "refId": "A",
          "expr": "sum by (supplier, interface, status) (rate(supplier_io_access_count_total{job=\"trip-booking-spa\"}[5m]))",
          "legendFormat": "{{supplier}} {{interface}} {{status}}",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "每秒向供应商打出多少次调用，按终态拆开（CallStatus 六个值互斥且穷尽，故按 status 求和即总调用量）。数据源是通道层唯一闸门 BaseHttpAccess，各家各接口都从这里出去。"
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "成功率（quoted+no_inventory / 全部）",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "spa-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "spa-prom"
          },
          "refId": "A",
          "expr": "sum by (supplier, interface) (rate(supplier_io_access_count_total{job=\"trip-booking-spa\",status=~\"quoted|no_inventory\"}[5m])) / sum by (supplier, interface) (rate(supplier_io_access_count_total{job=\"trip-booking-spa\"}[5m]))",
          "legendFormat": "{{supplier}} {{interface}}",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "无货(no_inventory)算成功——供应商答了就是通的,无货是业务正常态。失败=rejected/error/timeout/throttled。"
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "延时 p90 / p99",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "spa-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "spa-prom"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.90, sum by (le, supplier, interface) (rate(supplier_io_access_time_bucket{job=\"trip-booking-spa\"}[5m])))",
          "legendFormat": "{{supplier}} {{interface}} p90",
          "editorMode": "code",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "spa-prom"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le, supplier, interface) (rate(supplier_io_access_time_bucket{job=\"trip-booking-spa\"}[5m])))",
          "legendFormat": "{{supplier}} {{interface}} p99",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "SLO 桶 50ms~10s 八档(MonitorService.TIME_SLO_MS),分位是桶间插值,桶界处最准。"
    },
